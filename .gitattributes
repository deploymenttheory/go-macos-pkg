# .gitattributes snippet to force users to use same line endings for project.
#
# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

*.json text eol=lf
*.sh text eol=lf

# Committed package fixtures are byte-exact oracles; a CRLF conversion on a
# Windows checkout would corrupt them silently.
*.pkg binary
*.aar binary
*.xar binary
*.cpio binary
*.p12 binary
*.bom binary
*.der binary
# The timestamp fixture holds a DER token and the exact bytes it attests
# to. The second is plain ASCII, so text=auto would give it CRLF on a
# Windows checkout and the message imprint would stop matching.
testdata/timestamp/** binary
